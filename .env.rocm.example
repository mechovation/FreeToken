# Optional overrides for compose.yaml. Plain `docker compose up -d` already
# uses these defaults. Shell variables override values in this file.
# Read the commented environment section in compose.yaml before tuning.
ROCM_MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
ROCM_RUNTIME_IMAGE=freetoken:rocm-hip-graphs
ROCM_MODEL_NAME=Qwen3.6-35B-A3B-NVFP4
ROCM_HF_CACHE=${HOME}/.cache/huggingface
ROCM_HF_OFFLINE=0
ROCM_MODELS_DIR=./models
ROCM_DEVICE=0
ROCM_BIND_ADDRESS=127.0.0.1
ROCM_PORT=1920
ROCM_MEMORY_RATIO=0.85
ROCM_GRAPH_MAX_BS=2
ROCM_MAX_REQUESTS=2
ROCM_PREFILL_LENGTH=2048
ROCM_KV_RESERVE_TOKENS=65536
ROCM_MOE_BACKEND=offload
ROCM_NVFP4_BACKEND=triton
ROCM_EXTRA_ARGS=
